    CaptureBall = 10,
    Elastico = 10,
    Rainbow = 10,
    Sombrero = 10
}

local MAX_SIZE = 10

local function GetPresetTargetSize(pName)
    local val = 1
    if pName == "Maradona" then
        val = math.max(val, CurrentSizes.Maradona or 1)
    elseif pName == "Head" then
        val = math.max(val, CurrentSizes.Header or 1)
    elseif pName == "Default" then
        val = math.max(val, CurrentSizes.Pass or 1, CurrentSizes.Shoot or 1, CurrentSizes.Elastico or 1, CurrentSizes.Maradona or 1)
    elseif pName == "Przewrotka" then
        val = math.max(val, CurrentSizes.Shoot or 1)
    elseif pName == "InFrontOfLegs" then
        val = math.max(val, CurrentSizes.Soffit or 1, CurrentSizes.Elastico or 1, CurrentSizes.Sombrero or 1)
    elseif pName == "BehindLegs" then
        val = math.max(val, CurrentSizes.Soffit or 1, CurrentSizes.Rainbow or 1)
    elseif pName == "CaptureBall" then
        val = math.max(val, CurrentSizes.CaptureBall or 1)
    end
    return math.clamp(val, 1, MAX_SIZE)
end

local function ApplySizes()
    local allPresets = {"Default", "Head", "Maradona", "Przewrotka", "InFrontOfLegs", "BehindLegs", "CaptureBall", "GK", "LowBlockLeft", "LowBlockRight", "Slide", "TorsoCatch"}
    for _, pName in ipairs(allPresets) do
        local sz = GetPresetTargetSize(pName)
        local targetVec = Vector3.new(sz, sz, sz)
        if ConfigModule[pName] and type(ConfigModule[pName]) == "table" then
            setreadonly(ConfigModule[pName], false)
            ConfigModule[pName].Size = targetVec
        end
        if internalPresets and internalPresets[pName] and type(internalPresets[pName]) == "table" then
            setreadonly(internalPresets[pName], false)
            internalPresets[pName].Size = targetVec
        end
    end
end

-- Hook HitboxModule.new
if not getgenv().SLPN_OriginalHitboxNew then
    getgenv().SLPN_OriginalHitboxNew = HitboxModule.new
    HitboxModule.new = function(id, presetName, params)
        local hb = getgenv().SLPN_OriginalHitboxNew(id, presetName, params)
        if hb then
            local sz = GetPresetTargetSize(presetName)
            hb.Size = Vector3.new(sz, sz, sz)
        end
        return hb
    end
end

-- Hook GetPartsInHitbox
if not getgenv().SLPN_OriginalGetPartsInHitbox then
    getgenv().SLPN_OriginalGetPartsInHitbox = HitboxModule.GetPartsInHitbox
    HitboxModule.GetPartsInHitbox = function(self)
        if self and self.Size then
            -- Automatically maintain scaled size
        end
        return getgenv().SLPN_OriginalGetPartsInHitbox(self)
    end
end

