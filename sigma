local function isSpectating(player)
    if player==Players.LocalPlayer then return false end
    local char=player.Character
    if not char then return true end
    if not char:FindFirstChild('HumanoidRootPart') then return true end
    for _,part in ipairs(char:GetDescendants()) do
        if part:IsA('BasePart') and part.Transparency<0.95 then return false end
    end
    return true
end
local spectateThread=nil
local function stopLoop()
    if spectateThread then task.cancel(spectateThread) spectateThread=nil end
    apanel.Visible=false
end
local function startLoop()
    stopLoop(); apanel.Visible=true; setNames({})
    spectateThread=task.spawn(function()
        while spectateOn do
            local list={}
            for _,p in ipairs(Players:GetPlayers()) do
                if isSpectating(p) then table.insert(list,p.Name) end
            end
            setNames(list); task.wait(1.5)
        end
    end)
end
