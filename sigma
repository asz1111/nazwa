local function slider(parent,label,axis,order)
    local row = Instance.new('Frame')
    row.Size = UDim2.new(1,0,0,SLIDER_H); row.BackgroundTransparency = 1
    row.LayoutOrder = order; row.Parent = parent
    local lbl = Instance.new('TextLabel')
